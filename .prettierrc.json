{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "importOrder": [
    "^react",
    ".+\\.(css|sass|scss|less)$",
    "^@?\\w",
    "~/*",
    "^\\.",
    "^\\./types",
    "^[^.]"
  ],
  "importOrderSeparation": true,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ]
}
